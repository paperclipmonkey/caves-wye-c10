  # =================================================================
  #  Cross-section cut lines
  #  `line section` drawn ACROSS the passage at the station where each
  #  section was taken, perpendicular to the passage, and as wide as the
  #  section itself. The letter at each end matches the caption on the
  #  pulled-out section, which is what ties the two together -- the line
  #  itself carries no reference to the scrap.
  # =================================================================
  # section A at station 2  (passage bears 174°, cut at 264°)
  line section
    190.1 -172.7
    56.4 -186.0
  endline
  point 206.8 -171.0 label -text "A" -scale xs -align center
  point 39.6 -187.7 label -text "A'" -scale xs -align center
