    # --- extended elevation control -------------------------------------
    extend start 1

  endcentreline


  # ===================================================================
  #  MAPS -- what goes on which sheet
  # ===================================================================

  map m-C10-plan -title "C10 -- plan"
    C10-plan
  endmap

  map m-C10-extended -title "C10 -- extended elevation"
    C10-ee
  endmap

  # The eight cross-section scraps SexyTopo created (C10PX2, C10PX3,
  # ... C10PX15) are still EMPTY -- they are anchored on the plan by
  # `point section -scrap ...` and will draw nothing until walls are
  # added to them in C10.plan.th2. Once they have content, wrap each in
  # its own map and offset them here so they stack instead of piling up
  # on a single origin:
  #
  #   map m-sect-2 -projection none -title "station 2"
  #     C10PX2
  #   endmap
  #   ...
  #   map m-C10-sections -projection none -title "C10 -- cross sections"
  #     m-sect-2  [0   0 m] none
  #     m-sect-3  [0  -6 m] none
  #     ...
  #   endmap

endsurvey
