encoding utf-8

# =====================================================================
#  C10 -- survey definition
#  ---------------------------------------------------------------
#  Captured with SexyTopo, 2026-09-06.
#  Lines marked  <<< EDIT  are placeholders -- change them.
#
#  See README.md for what the rest of this project does. The sister
#  project for C7 has the same structure with fuller commentary.
# =====================================================================

survey C10 -title "C10 -- Bric 4 Group" -entrance 1

  # SexyTopo's own filenames are kept so a fresh export from the phone
  # drops straight in without renaming anything.
  input "C10.plan.th2"        # plan projection + the cross-section scraps
  input "C10.ee.th2"          # extended elevation

  centreline

    # --- who, when, with what ----------------------------------------
    title "C10 main passage"
    date 2026.09.06                                    # <<< EDIT
    explo-date 2026.09.06                              # <<< EDIT

    # A person is "<first name> <surname>", exactly two whitespace-
    # separated parts; join extra forenames with a slash ("A N/Other").
    # "Bric 4 group" is rejected -- a person is exactly two parts.
    # Joining the forenames with "/" satisfies the parser and still
    # prints as "Bric 4 group" on the sheet.
    team "Bric/4 group" notes pictures                 # <<< EDIT
    team "A N/Other" instruments tape compass clino    # <<< EDIT

    explo-team "A N/Other"                             # <<< EDIT

    instrument compass clino tape "DistoX2 (laser + electronic compass)"
    instrument position "SexyTopo on Android"

    calibrate tape 0 1
    calibrate compass 0 1
    calibrate clino 0 1

    # --- units, declination, accuracy ---------------------------------
    units tape metres
    units compass clino degrees

    # The SexyTopo export carried no declination, so it is pinned to 0
    # to keep this identical to the raw data. Note that a `cs` + `fix`
    # is present below, so REMOVING this line makes Therion compute the
    # declination from its built-in geomagnetic model instead -- which
    # would silently rotate the whole survey. Change it deliberately.
    declination 0 degrees                              # <<< EDIT if known

    sd tape 0.01 metres
    sd compass 0.5 degrees
    sd clino 0.5 degrees

    # --- georeferencing ------------------------------------------------
    # These coordinates are REAL, from a GPS fix at the entrance
    # (unlike the C7 project, where they are placeholders). They give
    # altitudes above sea level, a geospatial PDF and a usable KML.
    # Position of station 1 as longitude, latitude, metres a.s.l.
    cs long-lat
    fix 1 -2.637971 51.837160 103.5   2.3 2.3 4.3

    # --- station metadata ---------------------------------------------
    # The comment on an entrance-flagged station is PRINTED on the map,
    # so keep it to a name.
    station 1 "C10 entrance"    entrance
    station 20 "End of survey"  continuation           # <<< EDIT

    # --- the data -------------------------------------------------------
    # A "to" station of "-" marks a SPLAY shot: used for passage walls
    # and the 3D model, not for the centreline. The repeated readings
    # SexyTopo kept are commented out; uncomment to have Therion average
    # them.
    data normal from to tape compass clino ignoreall
